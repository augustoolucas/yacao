{
  "description": "Implements scoped coding tasks from self-contained instructions.",
  "mode": "subagent",
  "temperature": 0.1,
  "permission": {
    "*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "question": "deny",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      ".opencode/plans/*": "deny"
    },
    "skill": {
      "*": "allow",
      "yacao-planning": "deny",
      "yacao-implementation": "deny",
      "yacao-review": "deny"
    },
    "bash": {
      "*": "allow",
      "command git*": "deny",
      "env git*": "deny",
      "cat *.env*": "ask",
      "git * push*": "ask",
      "git * stash*": "ask",
      "git * checkout*": "ask",
      "git * restore*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rm -r -f*": "ask",
      "rm -f -r*": "ask",
      "git * commit*": "deny",
      "git push*": "ask",
      "git stash*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git switch*": "ask",
      "git commit*": "deny"
    },
    "task": {
      "*": "deny",
      "explore": "allow"
    }
  },
  "prompt": "{file:./prompts/builder.md}"
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git commit*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-commit" },
          { "type": "command", "if": "Bash(git -* commit*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-commit" },
          { "type": "command", "if": "Bash(git push*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* push*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git merge*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* merge*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git cherry-pick*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* cherry-pick*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git revert*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* revert*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git am*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* am*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git rebase*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* rebase*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git pull*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* pull*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git reset*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* reset*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git checkout*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* checkout*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git restore*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* restore*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git switch*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* switch*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git clean*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* clean*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash -*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash -*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash save*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash save*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash push*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash push*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash pop*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash pop*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash apply*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash apply*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash drop*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash drop*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash clear*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash clear*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash branch*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash branch*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash store*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash store*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git stash create*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(git -* stash create*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(rm -*r*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(rm -*R*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(rm -*f*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(rm --recursive*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" },
          { "type": "command", "if": "Bash(rm --force*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" --native-sensitive" }
        ]
      }
    ]
  }
}
